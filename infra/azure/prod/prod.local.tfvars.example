# Copy to prod.local.tfvars (git-ignored) and fill in. The Makefile passes it
# automatically when it exists.

# Addresses allowed to reach operator SSH on the edge (port 2222) and the
# control plane (port 22). The dev box and the owner's laptop, never 0.0.0.0/0.
operator_cidrs = ["203.0.113.4/32"]

# Addresses allowed to reach 80 and 443 on the control plane. Pre-launch this
# is the same operator list, which means Coolify must issue certificates over
# DNS-01 rather than HTTP-01. At launch this becomes ["0.0.0.0/0"].
control_web_cidrs = ["203.0.113.4/32"]

# Operator SSH public keys. The first is also each VM's Azure admin key.
operator_authorized_keys = [
  "ssh-ed25519 AAAA... operator@laptop",
]

# Private key matching one of the above, on the machine running tofu.
ssh_private_key_path = "/home/azureuser/.ssh/id_ed25519"

# Absolute path to this repository's nix/ directory.
flake_path = "/home/azureuser/projects/repose/nix"

# Cloudflare zone id for herakraft.co. The API token comes from the
# CLOUDFLARE_API_TOKEN environment variable, never from a file here.
cloudflare_zone_id = "0123456789abcdef0123456789abcdef"

# Entra object id of the api's service principal. Leave unset until the app
# registration exists; the Key Vault wrap/unwrap policy is skipped until then.
# api_identity_object_id = "00000000-0000-0000-0000-000000000000"

# The edge's WireGuard public key, read off the edge after its first install.
# Leave unset on the first apply.
# edge_wireguard_public_key = "..."
