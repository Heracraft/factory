{
  "hooks": {
    "Stop": [
      {"matcher": "", "hooks": [
        {"type": "command", "command": "afplay /System/Library/Sounds/Glass.aiff"},
        {"type": "command", "command": "echo laptop-stop"}
      ]},
      {"matcher": "", "hooks": [{"type": "command", "command": "/usr/local/bin/repose-hook --agent claude"}]}
    ],
    "Notification": [{"matcher": "", "hooks": [{"type": "command", "command": "repose-hook"}]}]
  },
  "permissions": {"allow": ["Read"], "deny": []}
}
