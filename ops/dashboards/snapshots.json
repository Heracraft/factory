{
  "uid": "repose-snapshots",
  "title": "repose / Snapshots",
  "description": "Nightly at 03:00 in the host's timezone and on every stop, kept 7 days (DESIGN \u00a76). A snapshot is the only thing between a host loss and a tenant losing work.",
  "tags": [
    "repose"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Oldest snapshot among running projects",
      "description": "The SnapshotStale input. Over 36 hours means two schedules have been missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "max(repose_api_snapshot_age_seconds)",
          "legendFormat": "age",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 86400
              },
              {
                "color": "red",
                "value": 129600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Snapshot failures today",
      "description": "A failed snapshot leaves the guest thawed and the previous snapshot in place; the cause is in the snapshot_fail line in Loki.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(repose_host_snapshot_duration_seconds_count{result!=\"ok\"}[24h]))",
          "legendFormat": "failures",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "p99 freeze window",
      "description": "DESIGN \u00a76 promises under one second. The guest is frozen for this long; every write in it blocks.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(repose_host_snapshot_freeze_seconds_bucket[$__range])))",
          "legendFormat": "p99",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3
    },
    {
      "type": "table",
      "title": "Age per running project",
      "description": "The table \u00a75 asks for. A null age is a running project that has never been snapshotted, which is worse than a stale one.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select p.slug as project, u.handle as owner, p.class, max(s.taken_at) as last_snapshot, extract(epoch from (now() - max(s.taken_at))) as age_seconds, max(s.bytes) as last_bytes from projects p join users u on u.id = p.user_id left join snapshots s on s.project_id = p.id and s.deleted_at is null where p.state = 'running' group by 1,2,3 order by age_seconds desc nulls first",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "age_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 86400
                    },
                    {
                      "color": "red",
                      "value": 129600
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last_bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Bytes per day",
      "description": "What is going into Blob, zstd-compressed. Retention is 7 daily per project, 30 days after a destroy.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select date_trunc('day', taken_at) as time, sum(bytes) as bytes from snapshots where $__timeFilter(taken_at) and deleted_at is null group by 1 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Snapshot duration by reason",
      "description": "scheduled is the nightly timer, stop is on a `repose stop`, manual is an operator. The upload to Blob dominates.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.9, sum by (le, reason) (rate(repose_host_snapshot_duration_seconds_bucket[1h])))",
          "legendFormat": "{{reason}} p90",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 6
    }
  ]
}
