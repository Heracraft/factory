{
  "uid": "repose-billing",
  "title": "repose / Billing",
  "description": "What will be invoiced, and whether the meters are keeping up. Invoices are built from usage_hours, so the rollup is the thing to watch (DECISIONS R4-7).",
  "tags": [
    "repose"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Rollup lag",
      "description": "Now minus the last hour rolled into usage_hours. Past two hours is RollupLag.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "max(repose_api_rollup_lag_seconds)",
          "legendFormat": "lag",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3600
              },
              {
                "color": "red",
                "value": 7200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Stripe push failures in the last hour",
      "description": "A failed usage record is money that will not appear on an invoice unless the reconciliation job repairs it.",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(repose_api_stripe_usage_push_total{result=\"error\"}[1h]))",
          "legendFormat": "failures",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Oldest unbilled hour",
      "description": "The age of the oldest usage_hours row with no Stripe record. Past six hours is StripePushBacklog; `repose-admin billing resync` re-pushes them (09-billing.md \u00a76).",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "max(repose_api_billing_stripe_push_backlog_seconds)",
          "legendFormat": "backlog",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3600
              },
              {
                "color": "red",
                "value": 21600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Reconciliation difference",
      "description": "The largest usage_hours minus Stripe difference the nightly reconciliation found. It reports and never fixes; `repose-admin billing explain` shows one row (09-billing.md \u00a75.7).",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "max(repose_api_billing_mismatch_cents)",
          "legendFormat": "cents",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Cost today",
      "description": "Across every project, from usage_hours. A project's own figure is capped at its monthly price (small 49, large 99, xl 199).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(sum(cost_cents), 0) / 100.0 as usd from usage_hours where hour >= date_trunc('day', now())",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Projects billing today",
      "description": "Projects that have run for part of today. A stopped project still bills its volume, and does not appear here.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select count(distinct project_id) as projects from usage_hours where hour >= date_trunc('day', now()) and running_seconds > 0",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Trial credit consumed per hour",
      "description": "The trial is consumed at the same rates as paid usage, so it is also the first test of the meters (DECISIONS R4-8). Only the billed half reaches Stripe.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select hour as time, sum(credit_cents) / 100.0 as credit_usd, sum(cost_cents - credit_cents) / 100.0 as billed_usd from usage_hours where $__timeFilter(hour) group by 1 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Guest hours per hour by class",
      "description": "The meter \u00a714 bills by: a running guest accrues, a stopped one does not. One guest running the whole hour is 1.0.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select hour as time, class, sum(running_seconds) / 3600.0 as guest_hours from usage_hours where $__timeFilter(hour) group by 1, 2 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Stripe usage pushes",
      "description": "Pushed hourly. While STRIPE_* is unset the routes return 503 billing_disabled and this stays flat (DECISIONS I-16).",
      "datasource": {
        "type": "prometheus",
        "uid": "repose-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "repose-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (result) (rate(repose_api_stripe_usage_push_total[15m]) * 900)",
          "legendFormat": "{{result}} / 15m",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Cost per project today",
      "description": "What `repose status` shows a user, for every project at once.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select p.slug as project, u.handle as owner, p.class, sum(h.running_seconds) / 3600.0 as guest_hours, max(h.gb_alloc) as gb_allocated, sum(h.egress_bytes) as egress, sum(h.cost_cents) / 100.0 as usd from usage_hours h join projects p on p.id = h.project_id join users u on u.id = p.user_id where h.hour >= date_trunc('day', now()) group by 1,2,3 order by usd desc limit 50",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "egress"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Egress per hour",
      "description": "500 GB a month is included per project, then $0.05 a GB. The per-project view is on the Abuse dashboard.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "repose-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "repose-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select hour as time, sum(egress_bytes) as egress from usage_hours where $__timeFilter(hour) group by 1 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 11
    }
  ]
}
