# The `api-grpc` Coolify application: the same image as `api`
# (cmd/api/Dockerfile) in gRPC mode, hosts (hostd) on 8443 and the gateway's
# /internal on 8444, both mTLS from the CA in Postgres (DECISIONS I-42).
# Coolify port mappings: 8443:8443, 8444:8444, 9104:9103. None are open on
# the public IP; hosts, the edge and Prometheus reach them over WireGuard at
# the VM's 10.255.255.1. No domain, no pre-deploy command (`api` runs the
# migrations); deploy it after `api`. Health: the image's HEALTHCHECK
# (`api -healthcheck` probes the metrics listener in this mode).

API_MODE=grpc
API_GRPC_LISTEN=:8443
API_INTERNAL_LISTEN=:8444
API_METRICS_LISTEN=:9103

# The server certificate is issued from the api's CA at start for these
# names (I-87); hosts are registered with apiServerName = the first one.
GRPC_SERVER_NAMES=api.repose.herakraft.co

DATABASE_URL=postgres://repose@repose-postgres-<service uuid>:5432/repose?sslmode=disable
PGPASSWORD={{project.POSTGRES_PASSWORD}}   # whole-value reference only; see api.env.example

KEYVAULT_URL=https://repose-kv-3912.vault.azure.net/
KEYVAULT_KEY_NAME=repose-dek-wrap
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
BLOB_ACCOUNT_URL=https://reposesnapshots3912.blob.core.windows.net/
BLOB_CONTAINER=repose-snapshots

GATEWAY_HOST=ssh.repose.herakraft.co
GATEWAY_PORT=22

RESEND_API_KEY=
NOTIFY_FROM=repose <notify@repose.herakraft.co>
DASHBOARD_URL=https://repose.herakraft.co
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Billing runs its background pushes from this process too (09).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COMPUTE=
STRIPE_PRICE_STORAGE=
STRIPE_PRICE_EGRESS=
STRIPE_METER_ID_COMPUTE=
STRIPE_METER_ID_STORAGE=
STRIPE_METER_ID_EGRESS=
STRIPE_AUTOMATIC_TAX=true
BILLING_ENFORCE=true
