# The `web` Coolify application: Dockerfile apps/web/Dockerfile, domain
# https://repose.herakraft.co:3000 (3000 is the container port), health
# check path /healthz on 3000 (wget is in the image). Everything the app
# reads is PUBLIC_* at runtime; no rebuild to change these.

PUBLIC_API_URL=https://api.repose.herakraft.co/v1
PUBLIC_LOGTO_ENDPOINT=https://accounts.herakraft.co
PUBLIC_LOGTO_APP_ID=          # the repose-web SPA application in Logto
PUBLIC_STRIPE_PUBLISHABLE_KEY=
