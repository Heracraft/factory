# The `api` Coolify application (Dockerfile cmd/api/Dockerfile, DECISIONS
# I-2, I-87): every variable it reads, with production values. Paste into
# the app's Environment tab (developer view); secrets stay there, never in
# a file. api-grpc.env.example is the sibling app; web.env.example the
# dashboard. Rolling deploy: Coolify uses the image's HEALTHCHECK
# (`api -healthcheck`), so leave Coolify's own health check off.

API_MODE=http
API_LISTEN=:8080
API_METRICS_LISTEN=:9103      # port mapping 9103:9103; scraped over WireGuard, never public

# The host is the Postgres container's name on the shared `coolify` network:
# the service name from ops/coolify/postgres/docker-compose.yml plus the
# Service's uuid (the one in its Coolify URL; `docker ps` on the VM shows
# it). Coolify attaches the container to that network after compose up, so
# the bare service name does not resolve there (docs/ops/coolify.md, fact
# 11). The password is deliberately not in
# the URL: Coolify resolves a {{project.X}} reference only when it is the
# variable's entire value, never inside a longer string (docs/ops/coolify.md,
# "Coolify facts"). pgx reads PGPASSWORD from the environment when the URL
# carries none, so the shared variable goes in on its own line.
DATABASE_URL=postgres://repose@repose-postgres-<service uuid>:5432/repose?sslmode=disable
PGPASSWORD={{project.POSTGRES_PASSWORD}}
# The owner's existing Logto (DECISIONS I-84): the endpoint, without /oidc.
# The api appends /oidc for the issuer claim, /oidc/jwks and /oidc/token.
LOGTO_ISSUER=https://accounts.herakraft.co
LOGTO_M2M_CLIENT_ID=
LOGTO_M2M_CLIENT_SECRET=
API_RESOURCE=https://api.repose.herakraft.co

KEYVAULT_URL=https://repose-kv-3912.vault.azure.net/
KEYVAULT_KEY_NAME=repose-dek-wrap
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
BLOB_ACCOUNT_URL=https://reposesnapshots3912.blob.core.windows.net/
BLOB_CONTAINER=repose-snapshots

GATEWAY_HOST=ssh.repose.herakraft.co
GATEWAY_PORT=22

RESEND_API_KEY=
NOTIFY_FROM=repose <notify@repose.herakraft.co>
DASHBOARD_URL=https://repose.herakraft.co
OTEL_EXPORTER_OTLP_ENDPOINT=   # unset: no traces exported
LOG_LEVEL=info

# Billing (workstream 09, DECISIONS I-16 and I-77). With STRIPE_SECRET_KEY
# unset the api starts normally and every /billing route answers
# 503 billing_disabled; usage still accrues in usage_hours and is pushed
# once the key is set. With it set, the webhook secret and the three prices
# are required, or the api refuses to start rather than billing nothing.
# ops/AZURE-SETUP.md step 17 creates the Stripe objects.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=         # from the endpoint, which must be created with the SDK's API version
STRIPE_PRICE_COMPUTE=          # price_..., 1 cent per unit, on the compute meter
STRIPE_PRICE_STORAGE=
STRIPE_PRICE_EGRESS=
STRIPE_METER_COMPUTE=repose_compute_cents   # meter event names; defaults shown
STRIPE_METER_STORAGE=repose_storage_cents
STRIPE_METER_EGRESS=repose_egress_cents
STRIPE_METER_ID_COMPUTE=       # mtr_..., read by `repose-admin billing reconcile`
STRIPE_METER_ID_STORAGE=
STRIPE_METER_ID_EGRESS=
STRIPE_PORTAL_RETURN_URL=      # defaults to DASHBOARD_URL/billing
STRIPE_AUTOMATIC_TAX=true      # Stripe Tax on the subscription (09-billing.md §5.9)
BILLING_ENFORCE=true           # false keeps metering and pushing but blocks no start
                               # and stops no guest; every flip writes an audit_log row

# Pre-deploy command on this app: repose-admin db migrate (I-87: `api` owns
# the schema; api-grpc has none and deploys after it).
